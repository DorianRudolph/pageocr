#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATH="${script_dir}/../target/release:${PATH}"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 1
  fi
}

normalize_preview() {
  tr '\r\n' '  ' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//' | cut -c1-180
}

make_tmp_dir() {
  case "$(uname -s)" in
    Darwin)
      mktemp -d -t pageocr-screenshot
      ;;
    *)
      mktemp -d "${TMPDIR:-/tmp}/pageocr-screenshot.XXXXXX"
      ;;
  esac
}

copy_ocr_output() {
  if [ -t 1 ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    pageocr "$image_path" | tee /dev/tty | "$1"
  else
    pageocr "$image_path" | "$1"
  fi
}

notify_success_macos() {
  preview=$(pbpaste | normalize_preview)

  if [ -n "$preview" ]; then
    osascript -e 'on run argv
display notification (item 1 of argv) with title "pageocr" subtitle "OCR copied to clipboard"
end run' -- "$preview"
  else
    osascript -e 'display notification "OCR copied to clipboard" with title "pageocr"'
  fi
}

notify_success_wayland() {
  if ! command -v notify-send >/dev/null 2>&1; then
    return 0
  fi

  preview=$(wl-paste --no-newline 2>/dev/null | normalize_preview || true)

  if [ -n "$preview" ]; then
    notify-send "pageocr" "$preview"
  else
    notify-send "pageocr" "OCR copied to clipboard"
  fi
}

capture_macos() {
  require_cmd screencapture
  require_cmd pbcopy
  require_cmd pbpaste
  require_cmd osascript

  if ! screencapture -i -x "$image_path"; then
    echo "Screenshot cancelled." >&2
    exit 1
  fi

  if [ ! -s "$image_path" ]; then
    echo "No screenshot captured." >&2
    exit 1
  fi

  copy_ocr_output pbcopy
  notify_success_macos
}

capture_wayland() {
  require_cmd grim
  require_cmd slurp
  require_cmd wl-copy
  require_cmd wl-paste

  region=$(slurp) || {
    echo "Screenshot cancelled." >&2
    exit 1
  }

  if [ -z "$region" ]; then
    echo "No screenshot region selected." >&2
    exit 1
  fi

  grim -g "$region" "$image_path"

  if [ ! -s "$image_path" ]; then
    echo "No screenshot captured." >&2
    exit 1
  fi

  copy_ocr_output wl-copy
  notify_success_wayland
}

require_cmd pageocr

tmp_dir=$(make_tmp_dir)

cleanup() {
  rm -rf -- "$tmp_dir"
}

trap cleanup EXIT INT TERM

image_path="$tmp_dir/capture.png"

case "$(uname -s)" in
  Darwin)
    capture_macos
    ;;
  Linux)
    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
      capture_wayland
    else
      echo "Linux screenshot helper currently supports Wayland only." >&2
      exit 1
    fi
    ;;
  *)
    echo "Unsupported platform: $(uname -s)" >&2
    exit 1
    ;;
esac

printf 'Copied OCR output to clipboard.\n' >&2
